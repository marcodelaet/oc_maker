# =============================================================================
# OC Maker — configuração por ambiente
# Copie para .env e ajuste conforme o servidor:
#   cp .env.example .env
# =============================================================================

# development | production
# development = faixa amarela/preta de aviso + título "DEV"
APP_ENV=development

# Caminho base na URL (sem barra final).
# Em produção com Alias (/maker), defina explicitamente no .env do servidor.
# Desenvolvimento (XAMPP/WAMP):
# APP_BASE_PATH=/oc_maker/web-php/public
# Produção (services.invian.ai):
# APP_BASE_PATH=/maker

# --- Banco de dados (desenvolvimento local) ---
# MySQL no mesmo host que o Apache:
DB_HOST=127.0.0.1
# Apache em Docker/Linux e MySQL no Windows/WSL ou no host:
# DB_HOST=host.docker.internal
# Container Apache/PHP local (dev Windows): webserver_php
# Permissões storage: database\fix-storage-docker.bat
# WSL2 + MySQL no Windows (XAMPP): use o IP do Windows — veja database/test-connection.php
# DB_HOST=172.x.x.x
# MySQL via socket Unix (sem TCP):
# DB_SOCKET=/var/run/mysqld/mysqld.sock
# DB_ALLOW_DOCKER_HOST=1
DB_PORT=3306
DB_NAME=oc_maker
DB_USER=theled
DB_PASS=abc@1234Led.

# --- Banco de dados (produção — descomente e use no servidor) ---
# APP_ENV=production
# DB_HOST=mysql.seu-servidor.invian.ai
# DB_PORT=3306
# DB_NAME=oc_maker_prod
# DB_USER=oc_maker_user
# DB_PASS=senha_segura_aqui
