RewriteEngine On

# Servir arquivos estáticos sem passar pelo front controller
RewriteRule ^(assets/|favicon\.png) - [L]

# URLs amigáveis (opcional — o frontend usa .php diretamente)
RewriteRule ^api/parse$ api/parse.php [L,QSA]
RewriteRule ^api/summary$ api/summary.php [L,QSA]
RewriteRule ^api/generate$ api/generate.php [L,QSA]
RewriteRule ^api/history$ api/history.php [L,QSA]
RewriteRule ^api/document$ api/document.php [L,QSA]
RewriteRule ^api/campaign$ api/campaign.php [L,QSA]
RewriteRule ^api/fees$ api/fees.php [L,QSA]

# Não redirecionar arquivos reais (api/*.php, assets/*)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteRule ^ index.php [L]
